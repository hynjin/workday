generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TaskStatus {
  active
  archived
}

enum WorkdayStatus {
  planning
  active
  completed
}

enum WorkdayItemStatus {
  planned
  completed
}

enum ProjectViewMode {
  list
  board
}

enum ProjectStatus {
  active
  completed
  archived
}

enum AreaStatus {
  active
  archived
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

enum ProductivityEventType {
  focus_completed
  task_completed
  key_task_completed
  workday_active
  weekly_goal_reached
}

model Task {
  id               String        @id @default(cuid())
  userId           String?       @db.Uuid
  projectId        String?
  areaId           String?
  sectionId        String?
  parentTaskId     String?
  title            String
  status           TaskStatus    @default(active)
  reusable         Boolean       @default(true)
  estimatedMinutes Int?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  archivedAt       DateTime?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area             Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  section          Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTask       Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks         Task[]        @relation("TaskHierarchy")
  items            WorkdayItem[]
  recurrenceRule   RecurrenceRule?

  @@index([projectId, status])
  @@index([areaId, status])
  @@index([userId, status])
  @@index([sectionId, sortOrder])
  @@index([parentTaskId, status])
}

model RecurrenceRule {
  id             String              @id @default(cuid())
  userId         String?             @db.Uuid
  taskId         String              @unique
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  weekdays       Int[]               @default([])
  monthDay       Int?
  startsOn       DateTime            @db.Date
  endsOn         DateTime?           @db.Date
  generatedUntil DateTime?           @db.Date
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  task           Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items          WorkdayItem[]

  @@index([generatedUntil])
  @@index([userId, generatedUntil])
}

model Project {
  id         String        @id @default(cuid())
  userId     String?       @db.Uuid
  areaId     String?
  title      String
  status     ProjectStatus @default(active)
  viewMode   ProjectViewMode @default(list)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  completedAt DateTime?
  area       Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks      Task[]
  sections   Section[]

  @@index([userId, status])
  @@index([areaId, status])
}

model Area {
  id         String     @id @default(cuid())
  userId     String?    @db.Uuid
  title      String
  status     AreaStatus @default(active)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?
  projects   Project[]
  tasks      Task[]

  @@index([userId, status])
}

model Section {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  projectId String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, sortOrder])
  @@index([userId, projectId])
}

model Workday {
  id          String         @id @default(cuid())
  userId      String?        @db.Uuid
  workdayDate DateTime       @db.Date
  status      WorkdayStatus  @default(planning)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       WorkdayItem[]
  productivityEvents ProductivityEvent[]

  @@unique([userId, workdayDate])
  @@index([userId, workdayDate])
}

model WorkdayItem {
  id                String            @id @default(cuid())
  userId            String?           @db.Uuid
  workdayId         String
  taskId            String?
  titleSnapshot     String
  legacyTitle       String            @map("title")
  status            WorkdayItemStatus @default(planned)
  isKeyTask         Boolean           @default(false)
  sortOrder         Int               @default(0)
  dailyGoalMinutes  Int?
  dismissedAt       DateTime?
  carriedFromItemId String?
  recurrenceRuleId  String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  workday           Workday           @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  task              Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  carriedFrom       WorkdayItem?       @relation("CarryChain", fields: [carriedFromItemId], references: [id], onDelete: SetNull)
  carriedTo         WorkdayItem[]      @relation("CarryChain")
  recurrenceRule    RecurrenceRule?    @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  focusSessions     FocusSession[]
  productivityEvents ProductivityEvent[]

  @@unique([workdayId, carriedFromItemId])
  @@unique([workdayId, taskId])
  @@index([workdayId, status])
  @@index([workdayId, sortOrder])
  @@index([taskId])
  @@index([carriedFromItemId])
  @@index([recurrenceRuleId])
  @@index([userId, workdayId])
}

model FocusSession {
  id              String      @id @default(cuid())
  userId          String?     @db.Uuid
  workdayItemId   String
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  taskTitleSnapshot String?
  projectTitleSnapshot String?
  areaTitleSnapshot String?
  createdAt       DateTime    @default(now())
  workdayItem     WorkdayItem @relation(fields: [workdayItemId], references: [id], onDelete: Cascade)

  @@index([workdayItemId])
  @@index([userId, startedAt])
}

model ProductivityEvent {
  id            String                @id @default(cuid())
  userId        String?               @db.Uuid
  type          ProductivityEventType
  points        Int
  ruleVersion   Int                   @default(1)
  dedupeKey     String                @unique
  workdayId     String?
  workdayItemId String?
  occurredAt    DateTime              @default(now())
  workday       Workday?              @relation(fields: [workdayId], references: [id], onDelete: SetNull)
  workdayItem   WorkdayItem?          @relation(fields: [workdayItemId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([workdayId])
  @@index([workdayItemId])
  @@index([userId, occurredAt])
}

model ProductivityGoal {
  id                 String   @id @default("default")
  userId             String?  @db.Uuid
  weeklyFocusMinutes Int      @default(300)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model WeeklyFocusGoal {
  id                 String    @id @default(cuid())
  userId             String?   @db.Uuid
  weekStart          DateTime  @db.Date
  weeklyFocusMinutes Int
  achievedAt         DateTime?
  finalFocusSeconds  Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, weekStart])
}
