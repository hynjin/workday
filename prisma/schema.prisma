generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TaskStatus {
  active
  archived
}

enum WorkdayStatus {
  planning
  active
  completed
}

enum WorkdayItemStatus {
  planned
  completed
}

enum ProjectViewMode {
  list
  board
}

model Task {
  id               String        @id @default(cuid())
  projectId        String?
  sectionId        String?
  title            String
  status           TaskStatus    @default(active)
  reusable         Boolean       @default(true)
  estimatedMinutes Int?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  archivedAt       DateTime?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section          Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  items            WorkdayItem[]

  @@index([projectId, status])
  @@index([sectionId, sortOrder])
}

model Project {
  id         String        @id @default(cuid())
  title      String
  status     TaskStatus    @default(active)
  viewMode   ProjectViewMode @default(list)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  tasks      Task[]
  sections   Section[]
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, sortOrder])
}

model Workday {
  id          String         @id @default(cuid())
  workdayDate DateTime       @unique @db.Date
  status      WorkdayStatus  @default(planning)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       WorkdayItem[]
}

model WorkdayItem {
  id                String            @id @default(cuid())
  workdayId         String
  taskId            String?
  titleSnapshot     String
  legacyTitle       String            @map("title")
  status            WorkdayItemStatus @default(planned)
  isKeyTask         Boolean           @default(false)
  sortOrder         Int               @default(0)
  carriedFromItemId String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  workday           Workday           @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  task              Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  carriedFrom       WorkdayItem?       @relation("CarryChain", fields: [carriedFromItemId], references: [id], onDelete: SetNull)
  carriedTo         WorkdayItem[]      @relation("CarryChain")
  focusSessions     FocusSession[]

  @@unique([workdayId, carriedFromItemId])
  @@unique([workdayId, taskId])
  @@index([workdayId, status])
  @@index([workdayId, sortOrder])
  @@index([taskId])
  @@index([carriedFromItemId])
}

model FocusSession {
  id              String      @id @default(cuid())
  workdayItemId   String
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime    @default(now())
  workdayItem     WorkdayItem @relation(fields: [workdayItemId], references: [id], onDelete: Cascade)

  @@index([workdayItemId])
}
