generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TaskStatus {
  active
  archived
}

enum WorkdayStatus {
  planning
  active
  completed
}

enum WorkdayItemStatus {
  planned
  completed
}

enum ProjectViewMode {
  list
  board
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

enum ProductivityEventType {
  focus_completed
  task_completed
  key_task_completed
  workday_active
  weekly_goal_reached
}

model Task {
  id               String        @id @default(cuid())
  projectId        String?
  sectionId        String?
  parentTaskId     String?
  title            String
  status           TaskStatus    @default(active)
  reusable         Boolean       @default(true)
  estimatedMinutes Int?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  archivedAt       DateTime?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section          Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTask       Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks         Task[]        @relation("TaskHierarchy")
  items            WorkdayItem[]
  recurrenceRule   RecurrenceRule?

  @@index([projectId, status])
  @@index([sectionId, sortOrder])
  @@index([parentTaskId, status])
}

model RecurrenceRule {
  id             String              @id @default(cuid())
  taskId         String              @unique
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  weekdays       Int[]               @default([])
  monthDay       Int?
  startsOn       DateTime            @db.Date
  endsOn         DateTime?           @db.Date
  generatedUntil DateTime?           @db.Date
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  task           Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items          WorkdayItem[]

  @@index([generatedUntil])
}

model Project {
  id         String        @id @default(cuid())
  title      String
  status     TaskStatus    @default(active)
  viewMode   ProjectViewMode @default(list)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  tasks      Task[]
  sections   Section[]
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, sortOrder])
}

model Workday {
  id          String         @id @default(cuid())
  workdayDate DateTime       @unique @db.Date
  status      WorkdayStatus  @default(planning)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       WorkdayItem[]
  productivityEvents ProductivityEvent[]
}

model WorkdayItem {
  id                String            @id @default(cuid())
  workdayId         String
  taskId            String?
  titleSnapshot     String
  legacyTitle       String            @map("title")
  status            WorkdayItemStatus @default(planned)
  isKeyTask         Boolean           @default(false)
  sortOrder         Int               @default(0)
  carriedFromItemId String?
  recurrenceRuleId  String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  workday           Workday           @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  task              Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  carriedFrom       WorkdayItem?       @relation("CarryChain", fields: [carriedFromItemId], references: [id], onDelete: SetNull)
  carriedTo         WorkdayItem[]      @relation("CarryChain")
  recurrenceRule    RecurrenceRule?    @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  focusSessions     FocusSession[]
  productivityEvents ProductivityEvent[]

  @@unique([workdayId, carriedFromItemId])
  @@unique([workdayId, taskId])
  @@index([workdayId, status])
  @@index([workdayId, sortOrder])
  @@index([taskId])
  @@index([carriedFromItemId])
  @@index([recurrenceRuleId])
}

model FocusSession {
  id              String      @id @default(cuid())
  workdayItemId   String
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime    @default(now())
  workdayItem     WorkdayItem @relation(fields: [workdayItemId], references: [id], onDelete: Cascade)

  @@index([workdayItemId])
}

model ProductivityEvent {
  id            String                @id @default(cuid())
  type          ProductivityEventType
  points        Int
  ruleVersion   Int                   @default(1)
  dedupeKey     String                @unique
  workdayId     String?
  workdayItemId String?
  occurredAt    DateTime              @default(now())
  workday       Workday?              @relation(fields: [workdayId], references: [id], onDelete: SetNull)
  workdayItem   WorkdayItem?          @relation(fields: [workdayItemId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([workdayId])
  @@index([workdayItemId])
}

model ProductivityGoal {
  id                 String   @id @default("default")
  weeklyFocusMinutes Int      @default(300)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
